# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Force scripts and configs to strictly use LF
*.sh text eol=lf
config/services-start text eol=lf
config/motel.conf.example text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# Windows PowerShell deployment script can keep CRLF or LF
deploy.ps1 text eol=crlf
